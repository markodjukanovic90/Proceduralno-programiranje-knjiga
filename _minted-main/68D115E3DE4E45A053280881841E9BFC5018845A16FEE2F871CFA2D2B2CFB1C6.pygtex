\PYG{k}{def} \PYG{n+nf}{NQueens}\PYG{p}{(}\PYG{n}{niz}\PYG{p}{,} \PYG{n}{N}\PYG{p}{):}
    \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{niz}\PYG{p}{)} \PYG{o}{==} \PYG{n}{N}\PYG{p}{:}
        \PYG{k}{return} \PYG{n}{niz}
    \PYG{k}{for} \PYG{n}{col} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{N}\PYG{p}{):}
        \PYG{n}{kandidat} \PYG{o}{=} \PYG{n}{niz} \PYG{o}{+} \PYG{p}{[}\PYG{n}{col}\PYG{p}{]}
        \PYG{k}{if} \PYG{n}{valid}\PYG{p}{(}\PYG{n}{kandidat}\PYG{p}{):}
            \PYG{n}{rezultat} \PYG{o}{=} \PYG{n}{NQueens}\PYG{p}{(}\PYG{n}{kandidat}\PYG{p}{,} \PYG{n}{N}\PYG{p}{)}
            \PYG{k}{if} \PYG{n}{rezultat} \PYG{o+ow}{is} \PYG{o+ow}{not} \PYG{k+kc}{None}\PYG{p}{:}
                \PYG{k}{return} \PYG{n}{rezultat}
    \PYG{k}{return} \PYG{k+kc}{None}


\PYG{n}{N} \PYG{o}{=} \PYG{l+m+mi}{8}
\PYG{n}{sol} \PYG{o}{=} \PYG{n}{NQueens}\PYG{p}{([],} \PYG{n}{N}\PYG{p}{)}
\PYG{k}{if} \PYG{n}{sol} \PYG{o+ow}{is} \PYG{o+ow}{not} \PYG{k+kc}{None}\PYG{p}{:}
    \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Rješenje je:\PYGZdq{}}\PYG{p}{,} \PYG{n}{sol}\PYG{p}{)}
\PYG{k}{else}\PYG{p}{:}
