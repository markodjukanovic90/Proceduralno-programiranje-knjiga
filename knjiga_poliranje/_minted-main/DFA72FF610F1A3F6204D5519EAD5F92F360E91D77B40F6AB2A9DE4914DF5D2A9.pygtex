\begin{Verbatim}[commandchars=\\\{\}]
	\PYG{n}{algoritam} \PYG{n+nb}{max}\PYG{p}{(}\PYG{n}{a}\PYG{p}{,} \PYG{n}{n}\PYG{p}{)}
