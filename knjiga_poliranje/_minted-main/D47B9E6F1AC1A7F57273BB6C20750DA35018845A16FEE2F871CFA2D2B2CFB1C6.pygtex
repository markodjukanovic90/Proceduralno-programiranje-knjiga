\begin{Verbatim}[commandchars=\\\{\}]
	\PYG{k}{def} \PYG{n+nf}{RecursiveInsertionSort}\PYG{p}{(}\PYG{n}{A}\PYG{p}{,} \PYG{n}{n}\PYG{p}{):}
	    \PYG{k}{if} \PYG{n}{n} \PYG{o}{\PYGZlt{}=} \PYG{l+m+mi}{1}\PYG{p}{:}
	        \PYG{k}{return}
	
	    \PYG{c+c1}{\PYGZsh{} Rekurzivno sortiramo prvih n\PYGZhy{}1 elemenata}
    	\PYG{n}{RecursiveInsertionSort}\PYG{p}{(}\PYG{n}{A}\PYG{p}{,} \PYG{n}{n} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}\PYG{p}{)}
	
	    \PYG{c+c1}{\PYGZsh{} Umetanje posljednjeg elementa}
	    \PYG{n}{key} \PYG{o}{=} \PYG{n}{A}\PYG{p}{[}\PYG{n}{n} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}\PYG{p}{]}
	    \PYG{n}{j} \PYG{o}{=} \PYG{n}{n} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{2}
	    \PYG{k}{while} \PYG{n}{j} \PYG{o}{\PYGZgt{}=} \PYG{l+m+mi}{0} \PYG{o+ow}{and} \PYG{n}{A}\PYG{p}{[}\PYG{n}{j}\PYG{p}{]} \PYG{o}{\PYGZgt{}} \PYG{n}{key}\PYG{p}{:}
	        \PYG{n}{A}\PYG{p}{[}\PYG{n}{j} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{]} \PYG{o}{=} \PYG{n}{A}\PYG{p}{[}\PYG{n}{j}\PYG{p}{]}
	        \PYG{n}{j} \PYG{o}{=} \PYG{n}{j} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}
	
	    \PYG{n}{A}\PYG{p}{[}\PYG{n}{j} \PYG{o}{+} \PYG{l+m+mi}{1}\PYG{p}{]} \PYG{o}{=} \PYG{n}{key}
\end{Verbatim}
