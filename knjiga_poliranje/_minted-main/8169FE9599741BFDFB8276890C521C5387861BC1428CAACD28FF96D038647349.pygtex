		\PYG{k}{def} \PYG{n+nf}{min\PYGZus{}dist\PYGZus{}pair}\PYG{p}{(}\PYG{n}{S}\PYG{p}{):}
		
		    \PYG{n}{min\PYGZus{}dist} \PYG{o}{=} \PYG{n+nb}{float}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}inf\PYGZdq{}}\PYG{p}{)}
		    \PYG{n}{point1} \PYG{o}{=} \PYG{k+kc}{None}
