               \PYG{k}{return} \PYG{n}{niz}
       \PYG{k}{else}\PYG{p}{:}
              \PYG{k}{for} \PYG{n}{col} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{N}\PYG{p}{):}
                  \PYG{n}{kandidat} \PYG{o}{=} \PYG{n}{niz} \PYG{o}{+} \PYG{p}{[}\PYG{n}{col}\PYG{p}{]}
