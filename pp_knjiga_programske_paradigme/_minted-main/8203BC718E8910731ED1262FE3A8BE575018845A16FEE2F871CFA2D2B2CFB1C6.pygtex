\PYG{k}{def} \PYG{n+nf}{closest\PYGZus{}pair}\PYG{p}{(}\PYG{n}{points}\PYG{p}{):}
    \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{points}\PYG{p}{)} \PYG{o}{\PYGZlt{}} \PYG{l+m+mi}{2}\PYG{p}{:}
